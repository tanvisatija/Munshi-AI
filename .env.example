# Copy to .env and fill in what you need. EVERYTHING here is optional —
# with no keys set, Munshi AI runs fully offline using data-driven fallbacks.
# Never commit your real .env (it is git-ignored).

# --- LLM (tried in order: Anthropic -> OpenAI -> built-in fallback) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high — low keeps dashboard/chat latency demo-friendly
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# auto | anthropic | openai | mock   ("mock" forces offline mode, e.g. demo with no Wi-Fi)
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=25

# --- Data ----------------------------------------------------------------------
# Defaults: backend/data/munshi.db and backend/data/exports (Docker: /data/...)
DATABASE_PATH=
EXPORTS_DIR=
# Seed synthetic data automatically when the database is empty
AUTO_SEED=true
# Anchor date (YYYY-MM-DD) for the 6 months of synthetic data. Empty = yesterday.
SEED_END_DATE=

# --- App -----------------------------------------------------------------------
# Initial state of the "Munshi AI Pro" demo toggle
PRO_ENABLED_DEFAULT=false
# Comma-separated origins allowed to call the API (only needed when the frontend
# is hosted on a different domain, e.g. Vercel/Netlify -> Render/Railway)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where the built frontend lives, if you want the API to serve it (single-process mode)
FRONTEND_DIST=

# --- Frontend build (Vite) -----------------------------------------------------
# Empty = call the API on the same origin. Set to the API's public URL when the
# frontend is hosted separately, e.g. https://munshi-api.onrender.com
VITE_API_URL=
# Host port for docker compose
WEB_PORT=8080
